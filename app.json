{
  "expo": {
    "name": "FXトレードログ",
    "slug": "fx-trade-journal",
    "version": "1.3.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "locales": {
      "ja": "./locales/ja.json",
      "en": "./locales/en.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "it": "./locales/it.json",
      "id": "./locales/id.json",
      "tr": "./locales/tr.json",
      "hi": "./locales/hi.json",
      "vi": "./locales/vi.json",
      "pt": "./locales/pt.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fxtradejournal.ios",
      "appleTeamId": "Z5S5Y76XDS",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "ja",
          "en",
          "de",
          "fr",
          "es",
          "it",
          "id",
          "tr",
          "hi",
          "vi",
          "pt"
        ],
        "CFBundleDevelopmentRegion": "ja",
        "LSApplicationQueriesSchemes": ["itms-apps"]
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.fxtradejournal.ios"]
      }
    },
    "android": {
      "package": "com.fxtradejournal.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "fx-trade-journal",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "トレードのチャート画像を添付するために写真へのアクセスを使用します。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#4F7EF7",
          "sounds": []
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-document-picker",
      "expo-font",
      "expo-updates",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "生体認証でアプリをロックし、トレード記録を保護します。"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "photomachi",
          "project": "fx-trade-journal"
        }
      ],
      "@bacons/apple-targets"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8a7d7dbf-6b86-4ed9-bf69-54d253c4251d",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000,
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a7d7dbf-6b86-4ed9-bf69-54d253c4251d"
      }
    }
  }
}
