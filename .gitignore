# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# ただしEAS Updateのコード署名用公開証明書はコミットする（秘密鍵ではない）
!certs/certificate.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# downloaded build artifacts (.aab/.ipa)
/build-artifacts

# eas metadata:pull が取得する App Store のスクリーンショット（約27MB）。
# ASC が正本で、`npx eas-cli metadata:pull --profile production` でいつでも
# 取り直せる。store.config.json はこのパスを参照するので、metadata:push を
# 実行する前に必ず pull しておくこと。
/store/
store.config.json.bak
